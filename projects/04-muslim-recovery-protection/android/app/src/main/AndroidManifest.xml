<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PLAY-eligible foundation manifest: no permissions and no historical M1 components.
         The VPN service, its permissions and the experimental harness live in
         src/internal/AndroidManifest.xml (M3-01 W0b). -->

    <application
        android:name=".app.TabsiraApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.MuslimRecoveryProtection"
        android:fullBackupContent="false">

        <!-- The product launcher. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MuslimRecoveryProtection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
