<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PLAY-eligible foundation manifest: no permissions and no historical M1 components.
         The VPN service, its permissions and the experimental harness live in
         src/internal/AndroidManifest.xml (M3-01 W0b). -->

    <application
        android:name=".app.TabsiraApplication"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.MuslimRecoveryProtection"
        android:fullBackupContent="false">

        <!-- The product launcher. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MuslimRecoveryProtection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- F9 (E3): AppCompat per-app locale persistence for API <= 32 (Android 13+ uses the platform).
             Disabled and not exported: it only carries the metadata flag. AppCompat may perform blocking disk
             reads/writes for this on API <= 32; accepted standard AppCompat behavior, no workaround added. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
